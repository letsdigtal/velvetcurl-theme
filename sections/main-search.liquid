{% comment %}Main search{% endcomment %}
<section class="search-page">
  <div class="page-width">
    <h1 class="search-page__title">
      {% if search.performed %}
        {{ 'general.results_for' | t }}: &ldquo;{{ search.terms | escape }}&rdquo;
      {% else %}
        {{ 'general.search' | t }}
      {% endif %}
    </h1>
    <form action="/search" method="get" class="search-page__form">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}..." aria-label="{{ 'general.search' | t }}">
      <button type="submit" class="btn">{{ 'general.search' | t }}</button>
    </form>

    {% if search.performed %}
      {% paginate search.results by 24 %}
        {% if search.results.size > 0 %}
          <p class="search-page__count">{{ search.results_count }} {{ 'general.products' | t }}</p>
          <div class="product-grid product-grid--3">
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                {% render 'product-card', product: item %}
              {% else %}
                <div class="product-card">
                  <div class="product-card__info">
                    <p class="eyebrow">{{ item.object_type | capitalize }}</p>
                    <h3 class="product-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            <nav class="pagination" aria-label="Pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="pagination__link">&larr; {{ 'general.previous' | t | default: 'Previous' }}</a>
              {% endif %}
              <span class="pagination__pages">{{ paginate.current_page }} / {{ paginate.pages }}</span>
              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="pagination__link">{{ 'general.next' | t | default: 'Next' }} &rarr;</a>
              {% endif %}
            </nav>
          {% endif %}
        {% else %}
          <p class="search-page__empty">{{ 'general.no_results' | t }}</p>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main search",
  "settings": []
}
{% endschema %}
