{% comment %}Newsletter signup{% endcomment %}
<section class="newsletter color-surface">
  <div class="page-width page-width--narrow newsletter__inner">
    {% if section.settings.heading != blank %}
      <h2 class="newsletter__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="rte newsletter__text">{{ section.settings.text }}</div>
    {% endif %}
    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.email_placeholder' | t }}</label>
      <input type="email"
             id="NewsletterEmail-{{ section.id }}"
             name="contact[email]"
             value="{{ form.email }}"
             placeholder="{{ 'general.email_placeholder' | t }}"
             autocorrect="off"
             autocapitalize="off"
             required>
      <button type="submit" class="btn">{{ 'general.subscribe' | t }}</button>
      {% if form.errors %}
        <p class="form__message form__message--error">{{ form.errors | default_errors }}</p>
      {% endif %}
      {% if form.posted_successfully? %}
        <p class="form__message form__message--success">{{ 'general.newsletter_success' | t }}</p>
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our community"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sign up for hair-care tips, new product announcements, and exclusive offers.</p>"
    }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
