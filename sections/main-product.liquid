{% comment %}Main product — gallery + title, price/size line, add-to-cart, accordion details{% endcomment %}
<section class="product" data-section-id="{{ section.id }}">
  <div class="page-width product__inner">
    <div class="product__media">
      {% if product.media.size > 0 %}
        <div class="product__gallery" data-product-gallery>
          <img class="product__featured-image"
               data-gallery-main
               src="{{ product.featured_media | image_url: width: 1200 }}"
               alt="{{ product.featured_media.alt | default: product.title | escape }}"
               width="1200"
               height="{{ 1200 | divided_by: product.featured_media.aspect_ratio | round }}">
          {% if product.media.size > 1 %}
            <div class="product__thumbnails">
              {% for media in product.media %}
                <button type="button"
                        class="product__thumbnail{% if forloop.first %} is-active{% endif %}"
                        data-gallery-thumb="{{ media | image_url: width: 1200 }}"
                        aria-label="View image {{ forloop.index }}">
                  <img src="{{ media | image_url: width: 200 }}"
                       alt="{{ media.alt | default: product.title | escape }}"
                       loading="lazy" width="200"
                       height="{{ 200 | divided_by: media.aspect_ratio | round }}">
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% else %}
        {% render 'placeholder-graphic', label: product.title, variant: 'a' %}
      {% endif %}
    </div>

    <div class="product__info">
      {% if section.settings.show_vendor and product.vendor != blank %}
        <p class="product__vendor">{{ product.vendor | escape }}</p>
      {% endif %}
      <h1 class="product__title">{{ product.title }}</h1>
      <p class="product__price-line">
        <span class="product__price">
          {% if product.compare_at_price_max > product.price %}
            <span class="price--sale">{{ product.price | money }}</span>
            <s class="price--compare">{{ product.compare_at_price_max | money }}</s>
          {% else %}
            {{ product.price | money }}
          {% endif %}
        </span>
        {% if section.settings.size_note != blank %}
          <span class="product__size-note">&mdash; {{ section.settings.size_note | escape }}</span>
        {% endif %}
      </p>
      {% if product.description != blank and section.settings.show_description %}
        <div class="rte product__description">{{ product.description | truncatewords: 60 }}</div>
      {% endif %}

      {% form 'product', product, data-product-form: '' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

        {% if product.variants.size > 1 %}
          <div class="product__options" data-variant-picker>
            {% for option in product.options_with_values %}
              <fieldset class="product__option">
                <legend>{{ option.name | escape }}</legend>
                {% for value in option.values %}
                  <label class="product__option-label">
                    <input type="radio"
                           name="options[{{ option.name | escape }}]"
                           value="{{ value | escape }}"
                           {% if option.selected_value == value %}checked{% endif %}
                           data-option-position="{{ option.position }}">
                    <span>{{ value | escape }}</span>
                  </label>
                {% endfor %}
              </fieldset>
            {% endfor %}
          </div>
          <script type="application/json" data-variants>{{ product.variants | json }}</script>
        {% endif %}

        <div class="product__buy-row">
          <div class="quantity" data-quantity>
            <button type="button" data-quantity-minus aria-label="{{ 'general.quantity' | t }} minus">{% render 'icons', icon: 'minus' %}</button>
            <input type="number" name="quantity" value="1" min="1" data-quantity-input aria-label="{{ 'general.quantity' | t }}">
            <button type="button" data-quantity-plus aria-label="{{ 'general.quantity' | t }} plus">{% render 'icons', icon: 'plus' %}</button>
          </div>
          <button type="submit"
                  class="btn btn--large product__add"
                  data-add-to-cart
                  {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}{{ 'general.add_to_cart' | t }}{% else %}{{ 'general.sold_out' | t }}{% endif %}
          </button>
        </div>
        <p class="product__added-message" data-added-message hidden>{{ 'products.product.added_to_cart' | t | default: 'Added to cart.' }}</p>
      {% endform %}

      {% if section.settings.show_accordion and product.description != blank %}
        <details class="accordion">
          <summary class="accordion__summary">{{ 'products.product.details' | t | default: 'Details' }} <span class="accordion__icon">{% render 'icons', icon: 'plus' %}</span></summary>
          <div class="rte accordion__content">{{ product.description }}</div>
        </details>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "text",
      "id": "size_note",
      "label": "Size note (e.g. 8.5 fl. oz.)",
      "default": "8.5 fl. oz. (250 ml)"
    },
    {
      "type": "checkbox",
      "id": "show_accordion",
      "label": "Show full description accordion",
      "default": true
    }
  ]
}
{% endschema %}
