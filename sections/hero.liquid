{% comment %}Hero — full-bleed image with overlaid headline, copy, CTA{% endcomment %}
<section class="hero" data-section-id="{{ section.id }}">
  <div class="hero__media">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 2000 }}"
           alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
           loading="eager" fetchpriority="high" width="2000"
           height="{{ 2000 | divided_by: section.settings.image.aspect_ratio | round }}">
    {% else %}
      {% render 'placeholder-graphic', label: section.settings.heading, variant: 'a' %}
    {% endif %}
    <div class="hero__scrim"></div>
  </div>
  <div class="page-width hero__content hero__content--{{ section.settings.alignment }}">
    {% if section.settings.eyebrow != blank %}
      <p class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <div class="hero__subtext rte">{{ section.settings.subtext }}</div>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn--large">{{ section.settings.button_label | escape }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Dermatologist-developed hair care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gentle Care for the Hair You Were Born With"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Thoughtfully chosen ingredients help calm dryness and itching while nourishing textured hair from root to tip — so every wash day feels like a fresh start.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 650
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
