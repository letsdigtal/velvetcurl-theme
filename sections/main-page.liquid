{% comment %}Main page (static pages){% endcomment %}
<section class="static-page">
  <div class="page-width page-width--narrow">
    <h1 class="static-page__title">{{ page.title }}</h1>
    {% if page.content != blank %}
      <div class="rte static-page__content">{{ page.content }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main page",
  "settings": []
}
{% endschema %}
