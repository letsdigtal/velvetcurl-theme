<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_accent }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  <title>
    {{ page_title }}
    {% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}
    {% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}
    {% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% render 'meta-tags' %}

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  {{ content_for_header }}

  <style>
    :root {
      --color-background: {{ settings.color_background }};
      --color-surface: {{ settings.color_surface }};
      --color-text: {{ settings.color_text }};
      --color-heading: {{ settings.color_heading }};
      --color-accent: {{ settings.color_accent }};
      --color-accent-text: {{ settings.color_accent_text }};
      --color-button-bg: {{ settings.color_button_bg }};
      --color-button-text: {{ settings.color_button_text }};
      --color-header-bg: {{ settings.color_header_bg }};
      --color-footer-bg: {{ settings.color_footer_bg }};
      --color-footer-text: {{ settings.color_footer_text }};
      --color-sale: {{ settings.color_sale }};
      --page-width: {{ settings.page_width }}px;
      --section-padding: {{ settings.section_padding }}px;
      --type-scale: {{ settings.type_scale | divided_by: 100.0 }};
      --button-radius: {% case settings.button_style %}{% when 'square' %}0{% when 'rounded' %}8px{% when 'pill' %}999px{% endcase %};
    }
    {{ settings.type_heading_font | font_face }}
    {{ settings.type_body_font | font_face }}
    :root {
      --font-heading: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
      --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    }
  </style>

  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ 'theme.css' | asset_url }}"></noscript>
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.suffix }}{% endif %}">
  <a class="skip-to-content" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'cart-drawer' %}

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    <li id="a11y-new-cart-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
  </ul>
</body>
</html>
